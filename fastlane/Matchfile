# Windbar signing assets live on the `windbar` ORPHAN branch of apple-certs.
#
# Not `master`. That branch mixes match-V2-encrypted certs with two *unencrypted*
# beeside .mobileprovision files, and match decrypts everything it clones, so it
# dies there with "Couldn't decrypt the repo, please make sure you enter the right
# password". The password is fine; the branch is inconsistent. The orphan branch
# keeps Windbar's storage clean and leaves beeside's files completely alone.
#
# The Apple Distribution cert on that branch is the SAME one master holds
# (4KXK5L7R43), copied byte for byte, so match reuses it and never mints a second.
#
# NEVER run `match nuke`, and never port beeside's certificate-prune step here. It
# keeps only the newest Distribution cert and revokes the rest, which would break
# beeside, lucidpal and medclear. They all share team KRPUAN3FFA.
#
# THIS IS FOR RECOVERY, NOT FOR CI. Normal builds use the persistent keychains
# already on the build VM and never invoke match. See `fastlane mac restore_signing`.
#
# Moved from GitHub (lucid-fabrics/lucidpal-certs) to this self-hosted Gitea repo
# 2026-07-31. Auth is via MATCH_GIT_BASIC_AUTHORIZATION (base64 "username:token"),
# supplied by whoever runs restore_signing - not stored in CI secrets.
#
# The URL itself comes from MATCH_GIT_URL rather than being written here: this repo
# is public on GitHub, and the Gitea box it points at is a bare LAN IP with no DNS
# name, so hardcoding it would publish internal network layout for no reason. See
# the runbook in the Gitea wiki, under restore_signing.
match_git_url = ENV['MATCH_GIT_URL']
UI.user_error!('MATCH_GIT_URL is not set. See the runbook in the Gitea wiki.') if match_git_url.to_s.empty?

git_url(match_git_url)
git_branch('windbar')
storage_mode('git')

type('appstore')
platform('macos')
app_identifier(['com.lucidfabrics.windbar'])
team_id('KRPUAN3FFA')

# The Mac App Store needs two certificates: Apple Distribution signs the .app and
# 3rd Party Mac Developer Installer signs the .pkg that gets uploaded.
additional_cert_types(['mac_installer_distribution'])

readonly(true)
