# Copy to fastlane/.env and fill in real values. fastlane loads .env automatically.
# fastlane/.env is gitignored: this .env.example (with no real values) is the only
# one that gets committed.
#
# These same six values also need to be set as Gitea Actions secrets on the repo
# (Settings > Actions > Secrets) with the identical names, since CI reads from
# there, not from this file. See the runbook in the Gitea wiki for the exact commands.

ASC_REVIEW_FIRST_NAME=
ASC_REVIEW_LAST_NAME=
ASC_REVIEW_EMAIL=
# Must start with + and country code, e.g. +15145550123
ASC_REVIEW_PHONE=
# A Dreo account with at least one fan bound to it, or App Review sees an empty
# device list and can reject under guideline 2.1.
ASC_REVIEW_DEMO_USER=
ASC_REVIEW_DEMO_PASSWORD=

# Only needed for `fastlane mac restore_signing` (recovery, not CI). The Gitea
# host has no DNS name, so its address is not written down here or in
# fastlane/Matchfile: this file is published to a public mirror, and an
# internal host address is nobody else's business. Ask the team for it.
MATCH_GIT_URL=http://<gitea-host>/lucidfabrics/apple-certs
MATCH_PASSWORD=
MATCH_GIT_BASIC_AUTHORIZATION=
