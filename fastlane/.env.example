# Only needed to run `fastlane mac release_dmg` on your own Mac. Copy to fastlane/.env
# and fill in real values; fastlane loads it automatically and it is gitignored.
#
# CI does not read this file. The release workflow takes the same five names from
# GitHub repository secrets (Settings > Secrets and variables > Actions).

# Developer ID Application identity: `base64 -i developer-id.p12 | pbcopy`
DEVELOPER_ID_P12_BASE64=
DEVELOPER_ID_P12_PASSWORD=

# App Store Connect API key, used only to notarize. ASC_KEY_P8 is the whole .p8 file contents.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_P8=

# Signs the Sparkle appcast.
SPARKLE_ED_PRIVATE_KEY=
