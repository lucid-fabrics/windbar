# Windbar - macOS release automation.
#
# The only product is a Developer ID signed, notarized DMG that updates itself
# through Sparkle, published as a GitHub release. Everything here runs on a
# GitHub-hosted runner, which starts every job with an empty machine, so there
# is nothing to unlock: `release_dmg` builds a throwaway keychain from secrets,
# signs with it and deletes it again in an `ensure`, whatever happens.
#
# Secrets, all read from the environment and never written to disk except for
# the notary key, which is removed in an `ensure` too:
#
#   DEVELOPER_ID_P12_BASE64     Developer ID Application identity, base64 of the .p12
#   DEVELOPER_ID_P12_PASSWORD   password that .p12 was exported with
#   ASC_KEY_ID                  notary API key id (an App Store Connect key, used only to notarize)
#   ASC_ISSUER_ID               issuer id of that key
#   ASC_KEY_P8                  the contents of the .p8 file
#   SPARKLE_ED_PRIVATE_KEY      signs the appcast

require 'base64'
require 'securerandom'
require 'tmpdir'

default_platform(:mac)

TEAM_ID = 'KRPUAN3FFA'
SCHEME  = 'Windbar'
PROJECT = 'Windbar.xcodeproj'

# Is the donation code actually inside this .app?
#
# `#if WINDBAR_DONATIONS` fails silently: the code compiles to nothing the
# moment no view references it, so "the flag is set" proves nothing, and the
# result would be a DMG with no way to donate. Grep the built binary instead of
# trusting the build setting.
#
# The needle is one payment link's own path segment, not the shared
# "buy.stripe.com" host string. Swift stores a string literal of 15 UTF-8
# bytes or fewer inline inside the String struct rather than as bytes in
# __TEXT,__cstring, so a 14-byte needle like "buy.stripe.com" would silently
# stop matching a binary that plainly ships the code the day someone factors
# that host out into a `let` (a base-URL constant, a `URLComponents` build-up
# - an entirely ordinary refactor). This is 23 bytes, well past that window,
# and unique to this app: it cannot vanish that way without the real payment
# link breaking too.
DONATION_LINK_NEEDLE = 'dRmfZg2K7aTOcD0dMMgYU00'


# Re-sign the executables Sparkle nests inside its own framework.
#
# Xcode signs Sparkle.framework, and stops there. The four helpers living
# inside it keep whatever signature they were built with upstream, which is
# not ours and carries no secure timestamp. `codesign --verify --deep
# --strict` is perfectly happy with that, because a valid signature is all it
# asks for. Apple's notary service is not, and names all four:
#
#   Autoupdate
#   Updater.app/Contents/MacOS/Updater
#   XPCServices/Downloader.xpc/Contents/MacOS/Downloader
#   XPCServices/Installer.xpc/Contents/MacOS/Installer
#
#   "The binary is not signed with a valid Developer ID certificate."
#   "The signature does not include a secure timestamp."
#
# Signing runs innermost first: sealing a nested bundle invalidates every
# signature above it, so the framework and then the app have to be sealed
# again afterwards or the app's own signature no longer matches its contents.
#
# The version directory is globbed rather than written as "Versions/B".
# Sparkle picks that letter, and a future release choosing another one would
# turn a hardcoded path into a silent no-op, which surfaces as a rejected
# notarization at the end of a long release run. Finding nothing is treated
# as an error here for the same reason.
def resign_sparkle_helpers!(app)
  framework = File.join(app, 'Contents/Frameworks/Sparkle.framework')
  return UI.important('No Sparkle.framework, so nothing to re-sign') unless File.directory?(framework)

  # Versions/Current is a symlink to the real directory; sign through the real one.
  versions = Dir.glob("#{framework}/Versions/*").reject { |p| File.symlink?(p) }
  UI.user_error!("Sparkle.framework has no version directory: #{framework}") if versions.empty?
  root = versions.first

  helpers = [
    "#{root}/XPCServices/Downloader.xpc",
    "#{root}/XPCServices/Installer.xpc",
    "#{root}/Updater.app",
    "#{root}/Autoupdate"
  ].select { |p| File.exist?(p) }

  if helpers.empty?
    UI.user_error!("Found no Sparkle helpers under #{root}. Their layout changed, and leaving " \
                   'them unsigned means Apple refuses the build at the end of the release.')
  end

  sign = "codesign --force --sign 'Developer ID Application' --options runtime --timestamp"
  # Innermost first, then the framework, then the app whose seal they all sit under.
  (helpers + [framework]).each do |target|
    UI.message("re-signing #{target.sub("#{app}/", '')}")
    sh("#{sign} #{target.shellescape}")
  end
  entitlements = File.expand_path('../config/Windbar.entitlements', __dir__)
  UI.user_error!("No entitlements at #{entitlements}") unless File.exist?(entitlements)
  sh("#{sign} --entitlements #{entitlements.shellescape} #{app.shellescape}")
end

# Submit to Apple's notary service and insist it actually came back Accepted.
#
# `notarytool submit --wait` exits 0 for a REJECTED submission. It reports
# "status: Invalid" on stdout and returns success, so a plain sh() sails
# straight past it into `stapler staple`, which then fails with "CloudKit
# query ... failed due to Record not found" - i.e. the one message that says
# nothing whatsoever about why Apple refused the build. That is exactly what
# happened on the first Sparkle release, and it cost far more time to diagnose
# than the underlying problem deserved.
#
# So: parse the status, and when it is anything but Accepted, pull the log
# Apple actually wrote and print it before failing. The log names the offending
# binary and the reason, which for a notarization failure is the whole answer.
def notarize!(path, notary)
  out = sh("xcrun notarytool submit #{path.shellescape} #{notary} --wait --timeout 30m", log: true)
  status = out[/^\s*status:\s*(.+)$/, 1].to_s.strip
  return if status == 'Accepted'

  id = out[/^\s*id:\s*(\S+)/, 1]
  UI.error("Notarization came back '#{status}' for #{File.basename(path)}.")
  if id
    UI.error('Apple\'s notarization log follows. It names the file and the reason.')
    sh("xcrun notarytool log #{id.shellescape} #{notary}", error_callback: ->(_) {})
  end
  UI.user_error!("Apple refused to notarize #{File.basename(path)} (status: #{status}). " \
                 'Nothing was published. See the log above for the offending binary.')
end

# Two independent signals. The framework is what Apple's automated checks
# would see; the link is what would actually crash or work at runtime. A
# build with one and not the other is broken either way, so both are asked.
def sparkle_present?(app)
  binary = File.join(app, 'Contents/MacOS/Windbar')
  UI.user_error!("No binary at #{binary}") unless File.exist?(binary)

  # Same reason donation_code_present? refuses these: an Xcode 16 Debug build
  # splits its code into a companion .debug.dylib and leaves a thin launcher
  # stub at the binary path, so the stub links nothing and this would report a
  # half-linked build. An archive merges them, and archives are all either
  # caller ever passes.
  dylib = File.join(app, 'Contents/MacOS/Windbar.debug.dylib')
  if File.exist?(dylib)
    UI.user_error!("#{dylib} exists, so this is a split Debug build rather than an archive. " \
                   'Its launcher stub links nothing, so no conclusion about Sparkle is possible.')
  end

  framework = Dir.exist?(File.join(app, 'Contents/Frameworks/Sparkle.framework'))
  linked    = `otool -L #{app.shellescape}/Contents/MacOS/Windbar 2>/dev/null`.include?('Sparkle.framework')

  if framework != linked
    UI.user_error!("Half-linked Sparkle in #{app}: framework embedded=#{framework}, " \
                   "binary links it=#{linked}. Neither shipping nor rejecting cleanly.")
  end
  framework
end

def donation_code_present?(app)
  binary = File.join(app, 'Contents/MacOS/Windbar')
  UI.user_error!("No binary at #{binary}") unless File.exist?(binary)

  # Xcode 16 splits a Debug BUILD's code into a companion .debug.dylib next to
  # a thin launcher stub, so grepping the stub alone reports "absent" for a
  # bundle that plainly contains the code. An xcodebuild ARCHIVE (what release_dmg
  # passes here) merges the dylib back into one executable and
  # never has this file, so its presence means this helper was pointed at
  # something other than an archive and cannot judge it either way.
  dylib = File.join(app, 'Contents/MacOS/Windbar.debug.dylib')
  if File.exist?(dylib)
    UI.user_error!("#{dylib} exists, so this is a split Debug build rather than an " \
                   'archive. donation_code_present? only reads the main executable and ' \
                   'would silently report the wrong answer for a bundle shaped like this.')
  end

  File.binread(binary).include?(DONATION_LINK_NEEDLE)
end

# Runs the block with a Developer ID Application identity available, and
# guarantees it is gone afterwards.
#
# A GitHub-hosted runner is a fresh VM, so there is no keychain to unlock:
# a new one is created, the certificate imported, and the keychain put on the
# search list so codesign and xcodebuild can find the identity by name. The
# partition list is what lets codesign use the private key without a UI
# prompt, which nothing on a headless runner could answer.
#
# The keychain password is random per run and never leaves this process. The
# original search list is restored and the keychain deleted in an `ensure`,
# so a failed notarization does not leave a signing identity behind on a
# machine that might be reused (a self-hosted runner, or a local dry run).
def with_temporary_signing_keychain
  p12_base64 = ENV['DEVELOPER_ID_P12_BASE64'].to_s.strip
  p12_password = ENV['DEVELOPER_ID_P12_PASSWORD'].to_s
  UI.user_error!('DEVELOPER_ID_P12_BASE64 is not set, so there is no identity to sign with.') if p12_base64.empty?
  UI.user_error!('DEVELOPER_ID_P12_PASSWORD is not set.') if p12_password.empty?

  dir = Dir.mktmpdir('windbar-signing')
  keychain = File.join(dir, 'windbar-signing.keychain-db')
  p12 = File.join(dir, 'developer-id.p12')
  password = SecureRandom.hex(24)
  original = `security list-keychains -d user`.scan(/"([^"]+)"/).flatten

  begin
    sh("security create-keychain -p #{password.shellescape} #{keychain.shellescape}", log: false)
    # No auto-lock: notarization can keep a job busy for a long time, and a
    # keychain that re-locks mid-run fails the signing step with no clear error.
    sh("security set-keychain-settings #{keychain.shellescape}", log: false)
    sh("security unlock-keychain -p #{password.shellescape} #{keychain.shellescape}", log: false)

    File.binwrite(p12, Base64.decode64(p12_base64))
    sh("security import #{p12.shellescape} -k #{keychain.shellescape} -P #{p12_password.shellescape} " \
       '-T /usr/bin/codesign -T /usr/bin/security', log: false)
    sh("security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k #{password.shellescape} " \
       "#{keychain.shellescape}", log: false)
    sh("security list-keychains -d user -s #{keychain.shellescape} #{original.map(&:shellescape).join(' ')}",
       log: false)

    identities = sh("security find-identity -v -p codesigning #{keychain.shellescape}", log: false)
    unless identities.include?('Developer ID Application')
      UI.user_error!('The imported certificate is not a Developer ID Application identity.')
    end
    yield
  ensure
    sh("security list-keychains -d user -s #{original.map(&:shellescape).join(' ')}", log: false) unless original.empty?
    sh("security delete-keychain #{keychain.shellescape}", log: false, error_callback: ->(_) {}) if File.exist?(keychain)
    FileUtils.rm_rf(dir)
  end
end

platform :mac do
  # The .xcodeproj is generated, never committed, so every lane regenerates it.
  private_lane :generate_project do
    UI.user_error!('xcodegen is not installed. brew install xcodegen') unless
      system('command -v xcodegen >/dev/null 2>&1')

    sh("cd #{File.expand_path('..', __dir__).shellescape} && xcodegen generate")
  end

  desc 'PR gate: build and run the unit tests. No signing, no upload.'
  lane :build_check do
    generate_project
    run_tests(
      project:     PROJECT,
      scheme:      SCHEME,
      destination: 'platform=macOS',
      # Signing off, so the gate is independent of certificates and keychains
      # and a PR from anywhere can be tested.
      xcargs: 'CODE_SIGNING_ALLOWED=NO',
    )
  end

  desc 'Build a Developer ID signed, notarized DMG and its Sparkle appcast.'
  lane :release_dmg do
    generate_project

    version = File.read(File.expand_path('../project.yml', __dir__))[/MARKETING_VERSION:\s*"([^"]+)"/, 1]
    UI.user_error!('Could not read MARKETING_VERSION from project.yml') if version.to_s.empty?
    # Epoch seconds, never the CI run counter. Sparkle decides whether an
    # update is newer by comparing this number first, so it has to keep
    # growing across every release ever made. A run counter restarts whenever
    # the CI system changes, and a release numbered below what is already
    # installed is silently treated as older and never offered.
    build_number = Time.now.to_i.to_s

    out = File.expand_path('../build/dmg', __dir__)
    FileUtils.rm_rf(out)
    FileUtils.mkdir_p(out)
    archive = "#{out}/Windbar.xcarchive"
    api_key_path = "#{out}/asc.p8"

    # xcbeautify is only for readability, so its absence must not break the
    # archive. A failed archive is caught by the missing-app check below.
    pretty = system('command -v xcbeautify > /dev/null') ? ' | xcbeautify' : ''

    begin
      with_temporary_signing_keychain do
        # The identity, entitlements, compilation conditions and Sparkle keys
        # all live in the target's own definition in project.yml. Only the team
        # and the version numbers come from the command line.
        sh("set -o pipefail && xcodebuild archive " \
           "-project #{File.expand_path('../' + PROJECT, __dir__).shellescape} " \
           "-scheme #{SCHEME} -configuration Release " \
           "-archivePath #{archive.shellescape} -destination 'generic/platform=macOS' " \
           "DEVELOPMENT_TEAM=#{TEAM_ID} " \
           "MARKETING_VERSION=#{version} CURRENT_PROJECT_VERSION=#{build_number} " \
           "OTHER_CODE_SIGN_FLAGS='--timestamp'#{pretty} || true")

        app = "#{archive}/Products/Applications/Windbar.app"
        UI.user_error!("No app at #{app}") unless File.exist?(app)
        resign_sparkle_helpers!(app)
        sh("codesign --verify --deep --strict --verbose=2 #{app.shellescape}")
        signer = sh("codesign -dv --verbose=2 #{app.shellescape} 2>&1 | grep Authority | head -1", log: false)
        UI.user_error!("App is not Developer ID signed: #{signer}") unless signer.include?('Developer ID Application')

        # Verify the sandbox actually came off, rather than trusting the target
        # definition. A sandboxed build would ship an updater that silently
        # cannot install anything, and the only symptom users would ever see is
        # that updates never apply. Read what is baked into the signature, which
        # is the only thing that counts at runtime.
        signed_entitlements = sh("codesign -d --entitlements - --xml #{app.shellescape} 2>/dev/null " \
                                 "| plutil -convert xml1 -o - -", log: false)
        if signed_entitlements.include?('com.apple.security.app-sandbox')
          UI.user_error!('The build is sandboxed. Its updater cannot replace the app from inside a ' \
                         'sandbox, so the entitlements in config/Windbar.entitlements did not take effect.')
        end

        # And that the capabilities are still there. Re-signing the app to seal the
        # Sparkle helpers hands codesign an entitlements file, so a wrong or empty
        # one would quietly produce an app that launches, looks fine, and cannot
        # reach the network or talk to a fan over Bluetooth. Both are read back out
        # of the signature rather than assumed from the file on disk.
        %w[com.apple.security.network.client com.apple.security.device.bluetooth].each do |capability|
          next if signed_entitlements.include?(capability)

          UI.user_error!("#{capability} is missing from the signed app. Re-signing dropped it, so this " \
                         'build could not reach Dreo or pair a fan. Check config/Windbar.entitlements.')
        end

        unless sparkle_present?(app)
          UI.user_error!('Sparkle is missing from the build. The Windbar target must depend on the ' \
                         'Sparkle package, because without the updater no installed copy can ever update.')
        end

        # An empty SUPublicEDKey makes Sparkle refuse every update. That is the
        # safe failure rather than the dangerous one, but it means shipping an app
        # whose updater can never do anything, so catch it at build time instead
        # of discovering it when a release fails to reach anybody.
        key = sh("/usr/libexec/PlistBuddy -c 'Print :SUPublicEDKey' " \
                 "#{app.shellescape}/Contents/Info.plist 2>/dev/null || true", log: false).strip
        UI.user_error!('SUPublicEDKey is empty in the build. Sparkle would reject every update ' \
                       'it is ever offered. Set SU_PUBLIC_ED_KEY on the Windbar target.') if key.empty?

        unless donation_code_present?(app)
          UI.user_error!('Donation code is missing from the build. WINDBAR_DONATIONS is set, so ' \
                         'the compiler stripped it: nothing in the UI references DonationCoordinator.')
        end
        UI.success("Build: unsandboxed, Sparkle present, update key #{key[0, 8]}…")

        File.write(api_key_path, ENV.fetch('ASC_KEY_P8'))
        File.chmod(0o600, api_key_path)
        notary = "--key #{api_key_path.shellescape} " \
                 "--key-id #{ENV.fetch('ASC_KEY_ID').shellescape} " \
                 "--issuer #{ENV.fetch('ASC_ISSUER_ID').shellescape}"

        # Notarize and staple the app FIRST. Stapling only the disk image leaves the
        # copy the user drags to /Applications without a ticket, so its first launch
        # needs network. Doing the app too makes it work offline.
        UI.important 'Notarizing the app'
        sh("ditto -c -k --keepParent #{app.shellescape} #{out.shellescape}/Windbar.zip")
        notarize!("#{out}/Windbar.zip", notary)
        sh("xcrun stapler staple #{app.shellescape}")

        dmg = "#{out}/Windbar-#{version}.dmg"
        stage = "#{out}/stage"
        FileUtils.mkdir_p(stage)
        FileUtils.cp_r(app, stage)
        File.symlink('/Applications', "#{stage}/Applications")
        sh("hdiutil create -volname Windbar -srcfolder #{stage.shellescape} -ov -format UDZO #{dmg.shellescape}")
        sh("codesign --sign 'Developer ID Application' --timestamp #{dmg.shellescape}")

        UI.important 'Notarizing the disk image'
        notarize!(dmg, notary)
        sh("xcrun stapler staple #{dmg.shellescape}")
        sh("xcrun stapler validate #{dmg.shellescape}")
        # The real test: would Gatekeeper let a downloader open this?
        sh("spctl -a -vvv -t install #{dmg.shellescape}")

        UI.success("Notarized #{dmg}")
        generate_update_appcast(dmg: dmg, version: version, out: out)
        dmg
      end
    ensure
      FileUtils.rm_f(api_key_path)
    end
  end

  # Writes the appcast: the XML feed installed copies poll to learn a newer
  # version exists, with this DMG's signature and size in it.
  #
  # Signed with the private half of the key whose public half is baked into
  # every build. That signature is the whole security model of the updater: it
  # is what makes a hijacked download or a spoofed release fail to install
  # rather than silently replacing the app with someone else's.
  private_lane :generate_update_appcast do |options|
    dmg     = options[:dmg]
    version = options[:version]
    out     = options[:out]

    private_key = ENV['SPARKLE_ED_PRIVATE_KEY'].to_s.strip
    UI.user_error!('SPARKLE_ED_PRIVATE_KEY is not set, so the appcast cannot be signed. Every ' \
                   'installed copy would refuse the resulting update.') if private_key.empty?

    tool = Dir.glob(File.expand_path(
      '~/Library/Developer/Xcode/DerivedData/Windbar-*/SourcePackages/artifacts/sparkle/Sparkle/bin/generate_appcast'
    )).first
    UI.user_error!('generate_appcast not found. It ships inside the resolved Sparkle package, ' \
                   'so the build must run before this.') unless tool

    # A directory holding ONLY this release's DMG. generate_appcast scans a
    # whole directory and lists everything it finds, so pointing it at the
    # build output would rebuild the feed from whatever old artifacts happen
    # to be lying around on the runner.
    feed_dir = "#{out}/appcast"
    FileUtils.rm_rf(feed_dir)
    FileUtils.mkdir_p(feed_dir)
    FileUtils.cp(dmg, feed_dir)

    # Each release keeps its assets under its own tag, so the download prefix
    # is per-version. The feed itself is fetched from releases/latest, which
    # always resolves to the newest release, so the URL baked into the app
    # never has to change.
    prefix = "https://github.com/#{ENV.fetch('GH_REPO', 'lucid-fabrics/windbar')}/releases/download/v#{version}/"

    # Key on stdin, never as an argument: arguments are visible to anyone who
    # can list processes on the runner, and `log: false` keeps it out of the
    # CI transcript too.
    sh("printf '%s' #{private_key.shellescape} | #{tool.shellescape} " \
       "--ed-key-file - " \
       "--download-url-prefix #{prefix.shellescape} " \
       "--link https://github.com/#{ENV.fetch('GH_REPO', 'lucid-fabrics/windbar')} " \
       "--maximum-versions 1 " \
       "#{feed_dir.shellescape}", log: false)

    appcast = "#{feed_dir}/appcast.xml"
    UI.user_error!("generate_appcast produced no appcast at #{appcast}") unless File.exist?(appcast)

    # Prove the feed describes THIS release and carries a signature, rather
    # than shipping a feed that parses but offers nothing or offers something
    # unverifiable.
    xml = File.read(appcast)
    UI.user_error!("Appcast does not mention #{version}") unless xml.include?(version)
    UI.user_error!('Appcast has no EdDSA signature') unless xml.include?('edSignature')
    UI.success("Appcast written for #{version}")
    appcast
  end
end
